# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=busreisen_db
DB_USER=your_db_user
DB_PASS=your_db_password
DB_DIALECT=postgres
DB_SSL=false

# Session Configuration
SESSION_SECRET=your_session_secret_key_here_min_32_chars

# JWT Configuration
JWT_SECRET_ACCESS=your_jwt_access_secret_here_min_32_chars
JWT_SECRET_REFRESH=your_jwt_refresh_secret_here_min_32_chars

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN_ADMIN=http://localhost:3001

# Payment Gateway (LiqPay)
LIQPAY_PUBLIC_KEY=your_liqpay_public_key
LIQPAY_PRIVATE_KEY=your_liqpay_private_key
LIQPAY_CALLBACK_URL=http://localhost:5000/api/payment/liqpay-callback

# Email Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_password
ADMIN_EMAIL=admin@example.com

# Redis Configuration (Optional - for session storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
