# Copy to .env and adjust. Values below match infra/docker-compose.dev.yml
# when the API runs on the host (npm run dev) against the Compose services.

# Server
NODE_ENV=development
PORT=5000
# Must include /api — used to build admin activation links
API_URL=http://localhost:5000/api
ADMIN_URL=http://localhost:3001

# Optional local HTTPS (leave empty for plain HTTP)
DEV_HTTPS_KEY_PATH=
DEV_HTTPS_CERT_PATH=

# Database (MySQL only)
DB_HOST=127.0.0.1
# 3307 = the Compose MySQL as published on the host
DB_PORT=3307
DB_NAME=busora_dev
DB_USER=busora
DB_PASS=busora_dev_password
DB_DIALECT=mysql

# Session (min 32 chars)
SESSION_SECRET=change_me_session_secret_min_32_chars
# The session cookie is HTTPS-only unless this is "false" — needed for the
# plain-HTTP local stack. Never set it to false behind HTTPS.
SESSION_COOKIE_SECURE=false

# JWT (min 32 chars each)
JWT_SECRET_ACCESS=change_me_jwt_access_secret_min_32_chars
JWT_SECRET_REFRESH=change_me_jwt_refresh_secret_min_32_chars

# CORS (comma-separated). The web app calls the API through its own /api
# proxy, so its requests are same-origin; only the admin panel needs an entry.
CORS_ORIGIN=
CORS_ORIGIN_ADMIN=http://localhost:3001

# Exchange rates (UAH per unit): "nbu" = live National Bank of Ukraine rates;
# "fixed" = offline, using FIXED_EXCHANGE_RATES (e.g. CZK=1.8)
EXCHANGE_RATE_PROVIDER=nbu
FIXED_EXCHANGE_RATES=

# Payments: "mock" (default — simulated, no money moves) or "liqpay"
PAYMENT_PROVIDER=mock
# Signs mock checkouts and callbacks (min 32 chars)
MOCK_PAYMENT_SECRET=change_me_mock_payment_secret_min_32_chars
# Only used when PAYMENT_PROVIDER=liqpay
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_CALLBACK_URL=http://localhost:5000/api/payment/liqpay-callback

# Email — Mailpit catches everything (web inbox: http://localhost:8025)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=noreply@busora.test
MAIL_PASS=mailpit
ADMIN_EMAIL=admin@busora.test

# Redis (optional — sessions fall back to memory without REDIS_HOST)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Demo admin-panel users created by `npm run seed` (min 8-char passwords).
# Leave empty to skip a user.
SEED_ADMIN_EMAIL=admin@busora.test
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=manager@busora.test
SEED_MANAGER_PASSWORD=
