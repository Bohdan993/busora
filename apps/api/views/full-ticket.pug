                if data.convertedPrice !== data.price && data.convertedPrice !== 0
                  = data.price
                  br
                  = "(" + data.convertedPrice + " UAH)"
                else
                  = data.price
      .ticket-info
        .ticket-info-container
          .ticket-data.ticket-info-block            
            div
              span
                = translations.ticketTypeText
              p
                - var ticketCategory = translations.ticketCategories.full
                - if (data.ticket.hasDiscount) {
                -   ticketCategory = translations.ticketCategories.promotional
                - } else {
                -   var passengersWithDiscount = data.passengersInfo.filter(function(passenger) {
                -     var discountName = passenger[1]["discount-name"]
                -     return discountName && discountName.trim() !== "" && discountName.trim() !== "-"
                -   })
                -   var passengersWithoutDiscount = data.passengersInfo.filter(function(passenger) {
                -     var discountName = passenger[1]["discount-name"]
                -     return !discountName || discountName.trim() === "" || discountName.trim() === "-"
                -   })
                -   if (passengersWithDiscount.length > 0 && passengersWithoutDiscount.length > 0) {
                -     ticketCategory = translations.ticketCategories.full_discount
                -   } else if (passengersWithDiscount.length > 0) {
                -     ticketCategory = translations.ticketCategories.discount
                -   }
                - }
                = ticketCategory /*+ " (" + data.ticket.type + ")"*/
            div
              span
                = translations.ticketNumberText
              p
                = data.ticket.ticketNumber
            div
              span
                = translations.ticketSeatText
              p
                = translations.ticketSeatInfoText
            div
              span
                = translations.dateOfBuingText
              p
                = transformTimestampToDate(data.ticket.createdAt)
          .image
            img(src=`${qr}` alt="QR code")
      .general-info
        .general-info-container
          .carrier.general-info-block
            img(src=`${logo}` alt="Logo")
          .carrier-info.general-info-block
            table.carrier-info-table
              tbody
                tr
                  td.carrier-info-left
                    table.carrier-info-inner-table
                      tbody
                        tr
                          td(colspan="1")
                            = translations.carrierText
                          td(colspan="3")
                            = translations.carrierInfoText
                        tr
                          td(colspan="1")
                            = translations.edrpouText
                          td(colspan="3")
                            |00000000
                        tr
                          td(colspan="1")
                            = translations.licenseText
                          td(colspan="3")
                            = translations.licenseInfoText
                  td.carrier-info-right
                    table.carrier-info-inner-table
                      tbody
                        tr
                          td(colspan="1")
                            = translations.legalAddressText
                          td(colspan="3")
                            = translations.legalAddressInfoText
                        tr
                          td(colspan="1")
                            = translations.actualAddressText
                          td(colspan="3")
                            = translations.actualAddressInfoText
                        tr
                          td(colspan="1")
                            = translations.contactsText
