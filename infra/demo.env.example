# Busora public demo settings. Copy to demo.env next to docker-compose.demo.yml
# on the server and fill in every empty value. Never commit demo.env.
# Random secrets: openssl rand -hex 32

# Images built by .github/workflows/deploy-demo.yml (owner in lowercase)
BUSORA_IMAGE_PREFIX=ghcr.io/OWNER/busora
BUSORA_IMAGE_TAG=latest

# Hostnames: point their DNS A/AAAA records at the server first, so Caddy can
# get certificates. ACME_EMAIL receives Let's Encrypt expiry notices.
DEMO_SITE_HOST=demo.example.com
DEMO_ADMIN_HOST=admin.example.com
DEMO_MAIL_HOST=mail.example.com
ACME_EMAIL=you@example.com

# The Mailpit inbox login. Make the hash with
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
# and keep the single quotes: the hash contains $ signs.
MAILPIT_USER=busora
MAILPIT_PASSWORD_HASH=''

# Database
DB_NAME=busora_demo
DB_USER=busora
DB_PASS=
MYSQL_ROOT_PASSWORD=

# API secrets, at least 32 characters each
SESSION_SECRET=
JWT_SECRET_ACCESS=
JWT_SECRET_REFRESH=
MOCK_PAYMENT_SECRET=

# Exchange rates: "nbu" (live) or "fixed" with FIXED_EXCHANGE_RATES=CZK=2.08
EXCHANGE_RATE_PROVIDER=nbu
FIXED_EXCHANGE_RATES=

# Sender shown on the demo emails (Mailpit catches all of them)
MAIL_USER=noreply@busora.test
ADMIN_EMAIL=admin@busora.test

# Per visitor IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# The private admin-panel logins (8–32 characters), created by every reset.
# Leave the manager empty to skip it.
SEED_ADMIN_EMAIL=admin@busora.test
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
